{
  "id": "upscale-walls",
  "name": "Upscale Walls",
  "version": "0.1.3",
  "author": "Synx-x <Synx-x@users.noreply.github.com>",
  "description": "Upscale small wallpapers on the GPU as you pick them, and keep the original untouched.",
  "license": "MIT",
  "official": false,
  "hosts": [
    "topbarGlyph"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml",
    "panel": "content/Panel.qml"
  },
  "panel": {
    "width": 340
  },
  "files": ["bin/upscale_walls.py"],
  "capabilities": {
    "densities": [
      "glyph",
      "compact"
    ]
  },
  "defaults": {
    "host": "topbarGlyph",
    "label": "Upscale Walls"
  },
  "dependencies": {
    "commands": ["python3", "magick", "ryogami", "waifu2x-ncnn-vulkan", "realesrgan-ncnn-vulkan", "notify-send"]
  },
  "metadata": {
    "settings": [
      {
        "key": "enabled",
        "type": "toggle",
        "label": "Upscale wallpapers when picked",
        "group": "Upscale Walls",
        "default": true
      },
      {
        "key": "mode",
        "type": "choice",
        "label": "Upscaler",
        "group": "Upscale Walls",
        "default": "auto",
        "options": [
          { "value": "auto", "label": "Auto (Real-ESRGAN if installed)" },
          { "value": "waifu2x", "label": "waifu2x (keeps grain, art)" },
          { "value": "realesrgan", "label": "Real-ESRGAN (cleans JPEG damage)" }
        ]
      },
      {
        "key": "targetWidth",
        "type": "int",
        "label": "Skip images at least this wide (px)",
        "group": "Upscale Walls",
        "default": 3840,
        "min": 1920,
        "max": 7680
      },
      {
        "key": "lingerSeconds",
        "type": "int",
        "label": "Keep the bar glyph after a result (seconds)",
        "group": "Upscale Walls",
        "default": 180,
        "min": 10,
        "max": 3600
      },
      {
        "key": "cacheMB",
        "type": "int",
        "label": "Cache size limit (MB)",
        "group": "Upscale Walls",
        "default": 2000,
        "min": 200,
        "max": 20000
      },
      {
        "key": "gpu",
        "type": "text",
        "label": "GPU index (blank = auto)",
        "group": "Upscale Walls",
        "default": "",
        "placeholder": "auto"
      }
    ]
  }
}
